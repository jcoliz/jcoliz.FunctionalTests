<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <!-- NuGet package metadata -->
        <PackageId>jcoliz.Net.FunctionalTests</PackageId>
        <Description>Base classes and infrastructure for Playwright-based functional tests using NUnit.</Description>
        <PackageTags>testing;test-utilities;playwright;nunit</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.63.0" />
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="DotNetEnv" Version="3.2.0" />
    </ItemGroup>

</Project>
